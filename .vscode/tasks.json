        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "warning",
          "pattern": {
            "regexp": "^%Warning(?:-[A-Z0-9_]+)?:\\s+(.+):(\\d+):(\\d+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        },
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": {
            "regexp": "^%Error(?:-[A-Z0-9_]+)?:\\s+(.+):(\\d+):(\\d+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        },
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+):(\\d+):\\s*(warning|error):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        }
      ]
    },
    {
      "label": "Verilog: wave",
      "type": "process",
      "command": "make",
      "args": [
        "wave"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Verilog: check",
      "type": "process",
      "command": "make",
      "args": [
        "check",
        "SRC_DIR=${input:srcDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
