            "message": 4
          }
        },
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": {
            "regexp": "^%Error(?:-[A-Z0-9_]+)?:\\s+(.+):(\\d+):(\\d+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        },
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+):(\\d+):\\s*(warning|error):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "srcDir",
      "type": "promptString",
      "description": "Ruta de los modulos Verilog, relativa al repositorio",
      "default": "src"
    }
  ]
}
