{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verilog: lint",
      "type": "process",
      "command": "make",
      "args": [
        "lint",
        "SRC_DIR=${input:srcDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "warning",
          "pattern": {
            "regexp": "^%Warning(?:-[A-Z0-9_]+)?:\\s+(.+):(\\d+):(\\d+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        },
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": {
            "regexp": "^%Error(?:-[A-Z0-9_]+)?:\\s+(.+):(\\d+):(\\d+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        },
        {
          "owner": "verilog",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+):(\\d+):\\s*(warning|error):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        }
      ]
    },
    {
      "label": "Verilog: sim",
      "type": "process",
      "command": "make",
